# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Tests / coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / local overrides
.env
.env.*
!.env.example
*.local

# Gremlyn local runtime (config.example.yaml stays tracked as the template)
.gremlyn/
gremlyn.yaml

# Python skill-script caches (e.g. .agents / .claude skills)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Impeccable local state (mirrors .git/info/exclude, shared for all clones)
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
