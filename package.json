{
  "name": "gremlyn",
  "version": "0.1.0",
  "private": true,
  "description": "Local PR resolution orchestrator — turns authorized GitHub review comments into controlled, isolated, observable agent runs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe:agent": "node --import tsx src/agent/probe.ts",
    "setup": "node --import tsx src/setup/cli.ts setup",
    "add-repo": "node --import tsx src/setup/cli.ts add-repo",
    "verify:config": "node --import tsx src/setup/cli.ts verify",
    "start": "node --import tsx src/index.ts",
    "start:built": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.1",
    "octokit": "^4.1.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
